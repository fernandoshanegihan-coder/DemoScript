# Copy this file to `.env.local` and fill in your own key.
# `.env.local` is gitignored — never commit it.
GEMINI_API_KEY=
# Optional model overrides. Leave empty for the defaults in lib/gemini.ts.
# Video analysis: gemini-3.8-flash (falls back to gemini-3.5-flash-lite).
# Context checks, story writing and scene rewrites use the lite model.
GEMINI_SCRIPT_MODEL=

# Optional automatic narration. Keep these server-side; never use NEXT_PUBLIC_.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Shared allowance per server process per UTC day (includes rate-adjustment retries).
AZURE_SPEECH_DAILY_CHAR_LIMIT=10000
